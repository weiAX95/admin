DATABASE_URL=postgres://admin:admin_local_only@127.0.0.1:55432/agent_admin
TEST_DATABASE_URL=postgres://admin:admin_local_only@127.0.0.1:55432/agent_admin_test
# BACKUP_ENCRYPTION_KEY=<独立生成的 32 字节十六进制密钥，不提交到 Git>
# BACKUP_DIR=/absolute/path/to/local/backups
# 可选：Markdown 图片附件目录；默认 mock/uploads
# ASSET_DIR=/absolute/path/to/uploads
# 可选：邮件提醒。未配置时站内通知仍可用；仅填写示例，不要提交真实凭据。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=sender@example.com
# SMTP_PASSWORD=replace-me
# SMTP_FROM=Learning Workspace <sender@example.com>
# OpenAI-compatible model endpoint (server-only; never exposed to Vite)
# MODEL_API_BASE_URL=https://your-provider.example/v1
# MODEL_API_KEY=replace-me
# 数据库模型连接加密：填 32 字节随机密钥的 64 位十六进制值；API 与独立 worker 必须相同。
# MODEL_CONNECTION_MASTER_KEY=<64 hex characters>
# MODEL_CONNECTION_KEY_VERSION=v1
# 轮换时将旧版本及其密钥放入 JSON 映射，新密钥填 MASTER_KEY，随后逐条替换连接密钥。
# MODEL_CONNECTION_PREVIOUS_KEYS={"v1":"<old 64 hex characters>"}
# 仅本地模拟供应商测试可放行回环 HTTP 地址；正式环境不要启用。
# ALLOW_LOCAL_MODEL_ENDPOINTS=1

# 自定义 Python 指标需先构建隔离镜像：docker build -f docker/evaluation-python.Dockerfile -t agent-eval-python:local .
# EVALUATION_PYTHON_IMAGE=agent-eval-python:local
# BERTScore 需独立大内存 worker，2 GB 开发机默认关闭；构建镜像后才可开启。
# EVALUATION_BERTSCORE_IMAGE=agent-eval-bertscore:local
# EVALUATION_BERTSCORE_ENABLED=false
# 独立运行评测 worker：HTTP API 进程设为 external，另开 npm run worker（两进程使用同一 DATABASE_URL）。
# EXPERIMENT_WORKER_MODE=external
# 供应商原生适配器凭据，仅在服务端读取
# OPENAI_API_KEY=replace-me
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# DASHSCOPE_API_KEY=replace-me
# QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# GEMINI_API_KEY=replace-me
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# 提示词图片／音频／视频附件目录及可选更低上传上限（字节）
# PROMPT_MEDIA_DIR=/absolute/path/to/prompt-media
# PROMPT_IMAGE_MAX_BYTES=10485760
# PROMPT_AUDIO_MAX_BYTES=52428800
# PROMPT_VIDEO_MAX_BYTES=524288000
# 提示词库只读手动同步；密钥仅在服务端使用，不返回页面。BASE_URL 填站点根地址。
# PROMPT_SYNC_LANGFUSE_BASE_URL=https://cloud.langfuse.com
# PROMPT_SYNC_LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
# PROMPT_SYNC_LANGFUSE_SECRET_KEY=sk-lf-replace-me
# PROMPT_SYNC_LANGSMITH_BASE_URL=https://api.smith.langchain.com
# PROMPT_SYNC_LANGSMITH_API_KEY=replace-me
# 自托管服务须将主机名显式加入白名单，例如 langfuse.internal.example
# PROMPT_SYNC_ALLOWED_HOSTS=langfuse.internal.example
