    "d3-force": "^3.0.0",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "nodemailer": "^10.0.15",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.0",
