{
  "name": "agent-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent 学习管理端：与 web 聊天端配套的学习任务管理控制台",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:vite": "vite",
    "mock": "node mock/server.mjs",
    "worker": "node mock/evaluation-worker.mjs",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:provision-app-role": "node scripts/db-provision-app-role.mjs",
    "db:import": "node scripts/db-import-json.mjs",
    "backup:create": "node scripts/backup-create.mjs",
    "backup:verify": "node scripts/backup-verify.mjs",
    "backup:restore:isolated": "node scripts/backup-restore-isolated.mjs",
    "build": "node scripts/check-changelog.mjs && tsc && vite build",
    "preview": "vite preview",
    "lint": "oxlint src/",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "benchmark:evaluation": "node --test tests/evaluation-benchmark.benchmark.mjs",
    "benchmark:evaluation-report": "node --test tests/evaluation-report-large.benchmark.mjs",
    "benchmark:project-analysis": "node scripts/project-analysis-benchmark.mjs",
    "benchmark:project-scan": "node --test tests/project-scan-large.benchmark.mjs",
    "benchmark:session-search": "node --test tests/session-search.benchmark.mjs",
    "benchmark:session-export": "node --test tests/session-export.benchmark.mjs",
    "benchmark:global-search": "node --test tests/global-search.benchmark.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@pdf-lib/fontkit": "^1.1.1",
    "antd": "^5.24.0",
    "chart.js": "^4.5.1",
    "d3-force": "^3.0.0",
    "diff": "^9.0.0",
    "ffprobe-static": "^3.1.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "nodemailer": "^10.0.15",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode.react": "4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/d3-force": "^3.0.10",
    "@types/diff": "^7.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.0",
    "oxlint": "^0.16.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
